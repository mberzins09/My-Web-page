    // ── Group batch create ─────────────────────────────────────────────────────
    void OnTeamCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var count))
        {
            teamCount = Math.Clamp(count, 2, 20);
            while (teamCountryIds.Count < teamCount) teamCountryIds.Add("");
            while (teamCountryIds.Count > teamCount) teamCountryIds.RemoveAt(teamCountryIds.Count - 1);
        }
    }

    async Task AddGroup()
    {
        groupError = null;
        if (string.IsNullOrWhiteSpace(groupName)) { groupError = "Group name is required."; return; }

        List<GroupTeam> teamEntries;
        if (!string.IsNullOrWhiteSpace(teamNamesManual))
        {
            teamEntries = teamNamesManual
                .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Select(t => new GroupTeam { TeamName = t })
                .ToList();
        }
        else
        {
            teamEntries = new List<GroupTeam>();
            foreach (var idText in teamCountryIds)
            {
                if (!int.TryParse(idText, out var id)) continue;
                var country = countries.FirstOrDefault(c => c.Id == id);
                if (country == null) continue;

                string sport = CountryService.ResolveSport(tournament!);
                teamEntries.Add(new GroupTeam
                {
                    TeamName  = CountryService.Format(country, sport, tournament!.Year),
                    CountryId = id
                });
            }
        }

        if (teamEntries.Count < 2) { groupError = "Pick (or type) at least 2 teams."; return; }
        if (teamEntries.Select(t => t.TeamName).Distinct(StringComparer.OrdinalIgnoreCase).Count() != teamEntries.Count)
        {
            groupError = "Teams must be unique within the group."; return;
        }

        var group = new TournamentGroup
        {
            Name         = groupName.Trim(),
            Event        = groupEvent.Trim(),
            TournamentId = tournament!.Id,
            Teams        = teamEntries
        };

        await GameService.AddGroupWithGamesAsync(group, gamesPerPair);
        int gameCount = teamEntries.Count * (teamEntries.Count - 1) / 2 * Math.Max(1, gamesPerPair);
        groupMessage = $"Group \"{group.Name}\" created with {gameCount} games!";
        groupName = "";
        teamCount = 4;
        gamesPerPair = 1;
        teamCountryIds = new() { "", "", "", "" };
        teamNamesManual = "";
        await LoadData();
        await Task.Delay(3000);
        groupMessage = null;
    }

    async Task DeleteGroup(int groupId)
    {
        editingGroupId = null;
        await GameService.DeleteGroupAsync(groupId);
        await LoadData();
    }

    // ── Group team edit ────────────────────────────────────────────────────────
    void StartEditGroup(TournamentGroup group)
    {
        editingGroupId = group.Id;
        editGroupName  = group.Name;
        renameError    = null;
        renameMessage  = null;
        editTeamNames  = group.Teams.Select(t => t.TeamName).ToList();
        editTeamCountryIds = group.Teams.Select(_ => "").ToList();   // group teams aren't tracked to a country id, so selection starts blank
        while (editTeamCountryIds.Count < 2) editTeamCountryIds.Add("");
        groupEditUseSelection = false;   // start on the tab that already shows real data - the selects start blank
        groupEditError = null;
    }

    void CancelGroupEdit()
    {
        editingGroupId = null;
        editTeamNames  = new();
        editTeamCountryIds = new();
        groupEditError = null;
    }

    async Task RenameGroup()
    {
        renameError = null;
        renameMessage = null;

        if (editingGroupId is not int id) return;
        var newName = editGroupName.Trim();
        if (newName.Length == 0) { renameError = "Name can't be empty."; return; }

        await GameService.RenameGroupAsync(id, newName);
        renameMessage = "Renamed.";
        await LoadData();
    }

    async Task SaveGroupTeams()
    {
        groupEditError = null;

        var filled = groupEditUseSelection
            ? editTeamCountryIds.Select(FormatSelectedCountry).Where(t => !string.IsNullOrWhiteSpace(t)).ToList()
            : editTeamNames.Where(n => !string.IsNullOrWhiteSpace(n)).ToList();

        if (filled.Count < 2) { groupEditError = "Pick (or type) at least 2 teams."; return; }
        if (filled.Count != filled.Distinct(StringComparer.OrdinalIgnoreCase).Count())
        {
            groupEditError = "Teams must be unique."; return;
        }

        await GameService.UpdateGroupTeamsAsync(editingGroupId!.Value, filled);
        CancelGroupEdit();
        await LoadData();
    }

    // ── Assignment ─────────────────────────────────────────────────────────────
    async Task ApplyAssignment(int groupId)
    {
        int? tournamentId = null;
        if (assignSelections.TryGetValue(groupId, out var val) &&
            int.TryParse(val, out var tid))
            tournamentId = tid;

        await GameService.AssignGroupToTournamentAsync(groupId, tournamentId);
        assignMessage = "Assignment saved.";
        await LoadData();
        await Task.Delay(2000);
        assignMessage = null;
    }

