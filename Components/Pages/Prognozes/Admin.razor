    // ── Complete Tournament ────────────────────────────────────────────────────
    bool    completing     = false;
    string? completeMessage;
    bool    completeError  = false;

    List<string> stages => games?
        .Select(g => g.Stage)
        .Where(s => !string.IsNullOrEmpty(s))
        .Distinct()
        .OrderBy(StageOrder)
        .ToList() ?? new();

    List<Game> filteredGames => games?
        .Where(g => selectedStage == null || g.Stage == selectedStage)
        .Where(g => string.IsNullOrWhiteSpace(homeFilter) || g.HomeTeam.Contains(homeFilter, StringComparison.OrdinalIgnoreCase))
        .Where(g => string.IsNullOrWhiteSpace(awayFilter) || g.AwayTeam.Contains(awayFilter, StringComparison.OrdinalIgnoreCase))
        .OrderBy(g => StageOrder(g.Stage))
        .ThenBy(g => g.GameDate)
        .ToList() ?? new();

    int StageOrder(string stage) => stage.ToLower() switch
    {
        var s when s.Contains("grupa") => 0,
        "round of 32" => 1,
        "round of 16" => 2,
        "quarter-final" => 3,
        "semi-final" => 4,
        "final" => 5,
        _ => 99
    };

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        tournament     = await GameService.GetTournamentBySlugAsync(Slug);
        allTournaments = await GameService.GetAllTournamentsAsync();
        currentUserId  = (await UserContext.GetUserIdAsync()) ?? 0;
        if (tournament != null)
            groupEvent = tournament.Name;
        countries = await CountrySvc.GetAllAsync();
        if (tournament != null && !string.IsNullOrWhiteSpace(tournament.ParticipatingCountryIds))
        {
            var allowed = tournament.ParticipatingCountryIds
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(int.Parse)
                .ToHashSet();
            countries = countries.Where(c => allowed.Contains(c.Id)).ToList();
        }
        await LoadData();
    }

    async Task LoadData()
    {
        allGroups = await GameService.GetAllGroupsAsync();

        if (allGroups != null)
            foreach (var g in allGroups)
                assignSelections.TryAdd(g.Id, g.TournamentId?.ToString() ?? "");

        if (tournament != null)
        {
            games      = await GameService.GetMatchesByTournamentAsync(tournament.Id);
            groups     = await GameService.GetGroupsByTournamentAsync(tournament.Id);
            userGroups = await GameService.GetUserGroupsByTournamentAsync(tournament.Id);
            allUsers   = await GameService.GetAllUsersAsync();
        }
    }

    bool resolvingPlayoffs = false;
    List<string> playoffLog = new();

    bool matchingTeams = false;
    TeamMatchResult? matchResult;

    async Task MatchTeamsToCountries()
    {
        matchingTeams = true;
        matchResult = null;
        StateHasChanged();
        try
        {
            matchResult = await GameService.MatchTeamsToCountriesAsync(tournament!.Id);
            await LoadData();
        }
        finally { matchingTeams = false; }
    }

    async Task ResolvePlayoffsManually()
    {
        resolvingPlayoffs = true;
        playoffLog = new();
        try
        {
            playoffLog = await PlayoffSvc.ResolveAsync(tournament!.Id);
            if (playoffLog.Count == 0) playoffLog.Add("Nothing to resolve yet.");
            await LoadData();
