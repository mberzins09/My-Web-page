    }

    // ── Add single game ────────────────────────────────────────────────────────
    async Task AddGame()
    {
        gameForm.TournamentId = tournament!.Id;

        if (string.IsNullOrWhiteSpace(gameForm.HomeTeam))
        {
            var (text, ids) = ResolveSlot(singleHomeCountryIds);
            gameForm.HomeTeam       = text;
            gameForm.HomeCountryIds = ids;
        }
        if (string.IsNullOrWhiteSpace(gameForm.AwayTeam))
        {
            var (text, ids) = ResolveSlot(singleAwayCountryIds);
            gameForm.AwayTeam       = text;
            gameForm.AwayCountryIds = ids;
        }

        if (string.IsNullOrWhiteSpace(gameForm.HomeTeam) || string.IsNullOrWhiteSpace(gameForm.AwayTeam))
        {
            gameMessage = null;
            groupError  = null;
            gameError   = "Pick at least one team per side (or type them manually).";
            return;
        }

        await GameService.AddMatchAsync(gameForm);
        await PlayoffSvc.ResolveAsync(tournament!.Id);
        gameForm    = new() { GameDate = DateTime.Now };
        singleHomeCountryIds = new();
        singleAwayCountryIds = new();
        gameError   = null;
        gameMessage = "Game added!";
        await LoadData();
        await Task.Delay(2000);
        gameMessage = null;
    }

    /// <summary>
    /// "🇱🇻 Latvia(12)" for one selected country in the tournament's sport/year - used for group teams,
    /// which are always a single fixed team (never a placeholder slot).
    /// </summary>
    string FormatSelectedCountry(string countryIdText)
    {
        if (!int.TryParse(countryIdText, out var id)) return "";
        var country = countries.FirstOrDefault(c => c.Id == id);
        if (country == null) return "";

        string sport = CountryService.ResolveSport(tournament!);
        return CountryService.Format(country, sport, tournament.Year);
    }

    /// <summary>
    /// Turns the selected country ids into a team-slot's display text and stored id list.
    /// One country  → "🇱🇻 Latvia(12)", ranking looked up once at creation time (in the tournament's
    ///                 sport/year) so it stays frozen even if the ranking is edited later.
    /// 2+ countries → "🇱🇻/🇸🇪" (flags only) - a placeholder slot PlayoffService resolves once an
    ///                 earlier round decides which of them advances.
    /// Nothing picked → ("", null).
    /// </summary>
    (string Text, string? Ids) ResolveSlot(HashSet<int> selectedIds)
    {
        var ids = selectedIds.ToList();

        if (ids.Count == 0) return ("", null);

        if (ids.Count == 1)
        {
            var country = countries.FirstOrDefault(c => c.Id == ids[0]);
            if (country == null) return ("", null);
            string sport = CountryService.ResolveSport(tournament!);
            return (CountryService.Format(country, sport, tournament.Year), ids[0].ToString());
        }

        var flags = ids
            .Select(id => countries.FirstOrDefault(c => c.Id == id)?.FlagEmoji)
            .Where(f => !string.IsNullOrEmpty(f));
        return (string.Join("/", flags), string.Join(",", ids));
    }

    // ── Inline game edit ───────────────────────────────────────────────────────
    void StartInlineEdit(Game game)
    {
        editingGameId = game.Id;
        editHomeTeam  = game.HomeTeam;
        editAwayTeam  = game.AwayTeam;
        editStage     = game.Stage;
        editDateError = null;

        // Pre-select the dropdown if this game already tracks countries; otherwise default to the
        // plain-text tab so an old/manually-typed game doesn't show an empty, misleading selection.
        editHomeCountryIds = PlayoffService.ParseIds(game.HomeCountryIds).ToHashSet();
        editAwayCountryIds = PlayoffService.ParseIds(game.AwayCountryIds).ToHashSet();
        editUseSelection   = editHomeCountryIds.Count > 0 || editAwayCountryIds.Count > 0;

        var local = game.GameDate.Kind == DateTimeKind.Utc
            ? game.GameDate.ToLocalTime()
            : game.GameDate;

        editDay    = local.Day;
        editMonth  = local.Month;
        editYear   = local.Year;
        editHour   = local.Hour;
        editMinute = local.Minute;
    }

    void CancelInlineEdit()
    {
        editingGameId = null;
        editDateError = null;
    }

    async Task SaveInlineEdit()
    {
        editDateError = null;

        if (!TryBuildDate(editYear, editMonth, editDay, editHour, editMinute,
                          out var localDt, out var err))
        {
            editDateError = err;
            return;
        }

        string homeTeam, awayTeam;
        string? homeIds, awayIds;

        if (editUseSelection)
        {
            (homeTeam, homeIds) = ResolveSlot(editHomeCountryIds);
            (awayTeam, awayIds) = ResolveSlot(editAwayCountryIds);
            if (string.IsNullOrWhiteSpace(homeTeam) || string.IsNullOrWhiteSpace(awayTeam))
            {
                editDateError = "Pick at least one team per side.";
                return;
            }
        }
        else
        {
            homeTeam = editHomeTeam.Trim();
            awayTeam = editAwayTeam.Trim();
            homeIds  = null;   // manually-typed text is no longer tracked to a country
            awayIds  = null;
        }

        var updated = new Game
        {
            Id              = editingGameId!.Value,
            HomeTeam        = homeTeam,
            AwayTeam        = awayTeam,
            HomeCountryIds  = homeIds,
            AwayCountryIds  = awayIds,
            Stage           = editStage.Trim(),
            GameDate        = localDt
        };

        await GameService.UpdateGameAsync(updated);
        editingGameId = null;
        await LoadData();
    }

    static bool TryBuildDate(int year, int month, int day, int hour, int minute,
                              out DateTime result, out string error)
    {
        result = default;
        error  = "";

        if (year   < 2020 || year   > 2099) { error = "Year must be 2020–2099.";   return false; }
        if (month  < 1    || month  > 12)   { error = "Month must be 1–12.";        return false; }
        if (day    < 1    || day    > 31)   { error = "Day must be 1–31.";           return false; }
        if (hour   < 0    || hour   > 23)   { error = "Hour must be 0–23.";          return false; }
        if (minute < 0    || minute > 59)   { error = "Minute must be 0–59.";        return false; }

        try
        {
            result = new DateTime(year, month, day, hour, minute, 0, DateTimeKind.Local);
            return true;
        }
        catch
        {
            error = $"{day}/{month}/{year} is not a valid date.";
            return false;
        }
    }

