@page "/lgtf-tt/admin"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using MartinsWeb.Models
@using MartinsWeb.Services
@attribute [Authorize(Roles = "Admin")]
@inject LgtfAdminService AdminSvc
@inject ForeignPointsService ForeignSvc
@inject LgtfImportService ImportSvc
@inject NavigationManager Nav

<PageTitle>Admin — Tournaments</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/lgtf-tt">🏓 Latvia TT</a></li>
        <li class="breadcrumb-item active">Admin</li>
    </ol>
</nav>

<h4>🛠 Tournament Admin</h4>

@* ── Foreign players: points from rankings1 ────────────────────────────── *@
<div class="border rounded p-3 mb-3" style="background:rgba(13,110,253,.06)">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <div>
            <label class="form-label mb-1 small">rankings1 month</label>
            <input type="text" class="form-control form-control-sm" style="width:110px"
                   placeholder="yyyy-MM" maxlength="7"
                   value="@_fpMonth" @onchange="e => _fpMonth = e.Value?.ToString() ?? _fpMonth"
                   disabled="@_fpBusy" />
        </div>
        <div class="form-check mb-0 align-self-end pb-1">
            <input class="form-check-input" type="checkbox" id="fpPreview" @bind="_fpPreview" disabled="@_fpBusy" />
            <label class="form-check-label small" for="fpPreview">Preview only (don't save)</label>
        </div>
        <button class="btn btn-primary btn-sm align-self-end" disabled="@_fpBusy" @onclick="RunForeignPointsAsync">
            🌍 Give foreigns points
        </button>
        @if (_fpBusy)
        {
            <span class="spinner-border spinner-border-sm text-primary align-self-end mb-1"></span>
        }
    </div>
    <div class="text-muted small mt-2">
        Compares players with a gender in PlayerDB and in rankings1, derives a coefficient per points range,
        and converts the rankings1 points of players without gender into Latvian-scale points.
        The result counts as their points at the start of that month; after saving, the month is
        recalculated so games played since then are applied.
    </div>

    @if (_fpError != null)
    {
        <div class="alert alert-danger mt-3 mb-0">@_fpError</div>
    }

    @if (_fpResult != null)
    {
        <div class="alert @(_fpResult.Applied ? "alert-success" : "alert-info") mt-3 mb-2 small">
            <div>
                <strong>@(_fpResult.Applied ? "✅ Saved." : "Preview - nothing saved.")</strong>
                Month @_fpResult.Month:
                <strong>@_fpResult.ForeignsUpdated</strong> foreign player(s) @(_fpResult.Applied ? "updated" : "would be updated").
            </div>
            <div>
                Calibrated on <strong>@_fpResult.CalibrationPlayers</strong> players with a gender.
                Typical error on those players: median <strong>@_fpResult.MedianAbsError.ToString("0")</strong> points,
                average <strong>@_fpResult.MeanAbsError.ToString("0")</strong>.
            </div>
            @if (_fpResult.ForeignsWithoutRanking > 0)
            {
                <div>@_fpResult.ForeignsWithoutRanking foreign player(s) have no points in rankings1 for this month - left unchanged.</div>
            }
            @if (_fpResult.RankingRowsWithoutPlayer > 0)
            {
                <div>@_fpResult.RankingRowsWithoutPlayer rankings1 row(s) have a player_id that is not in PlayerDB.</div>
            }
        </div>

        @if (_fpResult.RecalcLog.Count > 0)
        {
            <div class="border rounded p-2 mb-3"
                 style="max-height:160px;overflow-y:auto;font-size:.78rem;font-family:monospace;background:rgba(0,0,0,.05)">
                @foreach (var line in _fpResult.RecalcLog) { <div>@line</div> }
            </div>
        }

        <div class="row g-3">
            <div class="col-12 col-lg-5">
                <div class="fw-semibold small mb-1">Coefficient per range</div>
                <table class="table table-sm small mb-0">
                    <thead><tr><th>rankings1 points</th><th class="text-end">Players</th><th class="text-end">Coefficient</th></tr></thead>
                    <tbody>
                        @foreach (var b in _fpResult.Bins)
                        {
                            <tr>
                                <td>@b.MinX.ToString("0") – @b.MaxX.ToString("0")</td>
                                <td class="text-end">@b.Count</td>
                                <td class="text-end">× @b.Coefficient.ToString("0.000")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-12 col-lg-7">
                <div class="fw-semibold small mb-1">
                    Foreign players (highest first@(_fpResult.Rows.Count > 20 ? ", top 20 of " + _fpResult.Rows.Count : ""))
                </div>
                <table class="table table-sm small mb-0">
                    <thead><tr><th>Id</th><th>Player</th><th class="text-end">rankings1</th><th class="text-end">Before</th><th class="text-end">Now</th></tr></thead>
                    <tbody>
                        @foreach (var row in _fpResult.Rows.Take(20))
                        {
                            <tr>
                                <td>@row.PlayerId</td>
                                <td>@row.Name</td>
                                <td class="text-end">@row.SourcePoints.ToString("0")</td>
                                <td class="text-end">@row.OldPoints</td>
                                <td class="text-end"><strong>@row.NewPoints</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* ── Re-import API tournaments ──────────────────────────────────────────── *@
<div class="border rounded p-3 mb-3" style="background:rgba(255,193,7,.08)">
    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (!_extConfirm)
        {
            <button class="btn btn-outline-warning btn-sm" disabled="@_extBusy"
                    @onclick="() => _extConfirm = true">
                ♻️ Delete API tournaments &amp; re-import
            </button>
            <span class="text-muted small">
                Deletes all singles tournaments that came from the API, with their games, and imports them again
                (carried-over group games are stored only once). A backup copy is created first.
            </span>
        }
        else
        {
            <span class="small fw-semibold">Delete all API singles tournaments and re-import them? This can take several minutes.</span>
            <button class="btn btn-warning btn-sm" @onclick="RunReimportAsync">Yes, delete &amp; re-import</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _extConfirm = false">Cancel</button>
        }

        @if (_extBusy)
        {
            <span class="spinner-border spinner-border-sm text-warning"></span>
            <span class="small text-muted">Working…</span>
        }
    </div>

    @if (_extError != null)
    {
        <div class="alert alert-danger mt-3 mb-0">@_extError</div>
    }

    @if (_extResult != null)
    {
        <div class="alert alert-info mt-3 mb-2 small">
            <div>
                Deleted <strong>@_extResult.CompetitionsDeleted</strong> tournament(s) and <strong>@_extResult.GamesDeleted</strong> game(s).
                @if (_extResult.ImportFromDate != null) { <span> Re-import starts from <strong>@_extResult.ImportFromDate</strong>.</span> }
            </div>
            <div class="text-break">Backup: <code>@_extResult.BackupFile</code></div>
        </div>
    }

    @if (_extLog.Count > 0)
    {
        <div class="border rounded p-2"
             style="max-height:260px;overflow-y:auto;font-size:.78rem;font-family:monospace;white-space:pre-wrap;background:rgba(0,0,0,.05)">
            @foreach (var line in _extLog) { <div>@line</div> }
        </div>
    }
</div>

@* ── Database clean-up ─────────────────────────────────────────────────── *@
<div class="border rounded p-3 mb-4" style="background:rgba(220,53,69,.06)">
    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (!_confirmClean)
        {
            <button class="btn btn-outline-danger btn-sm" disabled="@_cleaning"
                    @onclick="() => _confirmClean = true">
                🧹 Clean database
            </button>
            <span class="text-muted small">
                Removes duplicate players (same key name) and deletes the old <code>players</code> table.
                A backup copy of the database is created first.
            </span>
        }
        else
        {
            <span class="small fw-semibold">Clean the database now? This changes lgtf.sqlite (a backup file is created first).</span>
            <button class="btn btn-danger btn-sm" @onclick="RunCleanAsync">Yes, clean</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmClean = false">Cancel</button>
        }

        @if (_cleaning)
        {
            <span class="spinner-border spinner-border-sm text-danger"></span>
            <span class="small text-muted">Working… this can take a little while.</span>
        }
    </div>

    @if (_cleanError != null)
    {
        <div class="alert alert-danger mt-3 mb-0">@_cleanError</div>
    }

    @if (_cleanResult != null)
    {
        <div class="alert alert-success mt-3 mb-0 small">
            <div><strong>✅ Database cleaned.</strong></div>
            <div>Duplicate rows removed: <strong>@_cleanResult.DuplicatesRemoved</strong> (players affected: @_cleanResult.DuplicateGroups)</div>
            <div>Game player-ids moved from a removed duplicate to the kept player: <strong>@_cleanResult.GamesRepointed</strong></div>
            <div>Game player-ids re-pointed to the PlayerDB id by key name: <strong>@_cleanResult.GamesResynced</strong></div>
            <div><code>players</code> table dropped: <strong>@(_cleanResult.PlayersTableDropped ? "yes" : "no")</strong> &nbsp;·&nbsp; file compacted: <strong>@(_cleanResult.Vacuumed ? "yes" : "no")</strong></div>
            <div class="text-break">Backup: <code>@_cleanResult.BackupFile</code></div>
        </div>
    }
</div>

<div class="d-flex align-items-end gap-3 mb-4 flex-wrap">
    <div>
        <label class="form-label mb-1">Year</label>
        <select class="form-select" style="width:110px"
                value="@_year" @onchange="OnYearChanged">
            <option value="0">— year —</option>
            @for (int y = DateTime.Today.Year; y >= 2013; y--)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label mb-1">Month</label>
        <select class="form-select" style="width:145px"
                value="@_month" @onchange="OnMonthChanged"
                disabled="@(_year == 0)">
            <option value="0">— month —</option>
            @foreach (var m in _months)
            {
                <option value="@m.Num">@m.Name</option>
            }
        </select>
    </div>
    @if (_loading)
    {
        <div class="align-self-center">
            <span class="spinner-border spinner-border-sm text-primary"></span>
        </div>
    }
</div>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_tournaments != null)
{
    @if (_tournaments.Count == 0)
    {
        <p class="text-muted">No tournaments found.</p>
    }
    else
    {
        <p class="text-muted mb-2">@_tournaments.Count tournament(s)</p>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Tournament</th>
                        <th class="text-center">Coef</th>
                        <th class="text-center">Games</th>
                        <th style="width:130px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _tournaments)
                    {
                        var tournament = t;
                        <tr>
                            <td class="text-nowrap">@tournament.Date</td>
                            <td>
                                @tournament.Name
                                @if (!string.IsNullOrEmpty(tournament.EventType) && tournament.EventType != "singles")
                                {
                                    <span class="badge bg-warning text-dark ms-1 small">@tournament.EventType</span>
                                }
                            </td>
                            <td class="text-center">×@tournament.Coef.ToString("0.##")</td>
                            <td class="text-center">@tournament.GameCount</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => GoToGames(tournament.Id)">
                                    Games
                                </button>
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => GoToEdit(tournament.Id)">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private int  _year  = 0;
    private int  _month = 0;
    private bool _loading = false;
    private string? _error = null;
    private List<AdminTournamentVm>? _tournaments = null;

    private string _fpMonth = DateTime.Today.ToString("yyyy-MM");
    private bool _fpPreview = true;
    private bool _fpBusy = false;
    private string? _fpError = null;
    private ForeignPointsResult? _fpResult = null;

    private bool _extConfirm = false;
    private bool _extBusy = false;
    private string? _extError = null;
    private DeleteExternalResult? _extResult = null;
    private readonly List<string> _extLog = new();

    private bool _confirmClean = false;
    private bool _cleaning = false;
    private string? _cleanError = null;
    private CleanDatabaseResult? _cleanResult = null;

    private record MonthItem(int Num, string Name);
    private static readonly List<MonthItem> _months = new()
    {
        new(1,"January"),   new(2,"February"), new(3,"March"),
        new(4,"April"),     new(5,"May"),       new(6,"June"),
        new(7,"July"),      new(8,"August"),    new(9,"September"),
        new(10,"October"),  new(11,"November"), new(12,"December"),
    };

    protected override async Task OnInitializedAsync()
    {
        _year  = DateTime.Today.Year;
        _month = DateTime.Today.Month;
        await LoadAsync();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        _year        = int.TryParse(e.Value?.ToString(), out var y) ? y : 0;
        _month       = 0;
        _tournaments = null;
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        _month = int.TryParse(e.Value?.ToString(), out var m) ? m : 0;
        if (_year > 0 && _month > 0)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_year == 0 || _month == 0) return;
        _loading     = true;
        _error       = null;
        _tournaments = null;
        StateHasChanged();
        try
        {
            _tournaments = await AdminSvc.GetTournamentsByYearMonthAsync(_year, _month);
        }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task RunForeignPointsAsync()
    {
        _fpBusy   = true;
        _fpError  = null;
        _fpResult = null;
        StateHasChanged();
        try
        {
            _fpResult = await ForeignSvc.AssignForeignPointsAsync(_fpMonth, apply: !_fpPreview);
        }
        catch (Exception ex) { _fpError = ex.Message; }
        finally { _fpBusy = false; }
    }

    private async Task RunReimportAsync()
    {
        _extConfirm = false;
        _extError   = null;
        _extResult  = null;
        _extLog.Clear();

        if (ImportSvc.IsRunning)
        {
            _extError = "An import is already running - wait for it to finish first.";
            return;
        }

        _extBusy = true;
        StateHasChanged();
        try
        {
            _extResult = await AdminSvc.DeleteExternalSinglesAsync();
            StateHasChanged();

            if (_extResult.CompetitionsDeleted > 0)
            {
                await ImportSvc.ImportSinglesAndTeamsAsync(LogExt);
            }
        }
        catch (Exception ex) { _extError = ex.Message; }
        finally { _extBusy = false; }
    }

    private void LogExt(string message)
    {
        _extLog.Add(message);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RunCleanAsync()
    {
        _confirmClean = false;
        _cleaning     = true;
        _cleanError   = null;
        _cleanResult  = null;
        StateHasChanged();
        try
        {
            _cleanResult = await AdminSvc.CleanDatabaseAsync();
        }
        catch (Exception ex) { _cleanError = $"Clean failed - nothing was changed. {ex.Message}"; }
        finally { _cleaning = false; }
    }

    private void GoToGames(int id) => Nav.NavigateTo("/lgtf-tt/admin/tournament/" + id + "/games");
    private void GoToEdit(int id)  => Nav.NavigateTo("/lgtf-tt/admin/tournament/" + id);
}
