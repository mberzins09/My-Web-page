@using MartinsWeb.Models

@* One game in a bracket: two player rows with sets, optional set points underneath. *@

@if (Game == null)
{
    <div class="match bye">
        <div class="side"><span class="name">@(ByeName ?? "—")</span><span>bye</span></div>
    </div>
}
else if (Game.IsBye)
{
    var real = Game.Player1 ?? Game.Player2;
    <div class="match bye">
        <div class="side"><span class="name">@TtLocalLabels.WithSeed(real, Seeds, "—")</span><span>bye</span></div>
    </div>
}
else
{
    <div class="match">
        @foreach (var first in _both)
        {
            var player = first ? Game.Player1 : Game.Player2;
            int? sets  = first ? Game.Player1Sets : Game.Player2Sets;
            bool won   = Game.IsFinished && Game.WinnerId == (first ? Game.Player1Id : Game.Player2Id);
            string cls = "side" + (won ? " winner" : "") + (player == null ? " tbd" : "");
            <div class="@cls">
                <span class="name">@TtLocalLabels.WithSeed(player, Seeds)</span>
                <span>@(sets?.ToString() ?? "")</span>
            </div>
        }
        @if (Game.Sets.Count > 0)
        {
            <div class="sets">@string.Join(", ", Game.Sets.OrderBy(s => s.SetNumber).Select(s => $"{s.Player1Points}:{s.Player2Points}"))</div>
        }
    </div>
}

@code {
    static readonly bool[] _both = { true, false };

    /// <summary>The game. Null = a round-1 slot of a single-elimination bracket that has no game (bye).</summary>
    [Parameter] public GameTT? Game { get; set; }

    /// <summary>playerId -> seed in the playoff. When given, names are shown as "Name Surname (seed)".</summary>
    [Parameter] public IReadOnlyDictionary<int, int>? Seeds { get; set; }

    /// <summary>Player shown on the bye card when Game is null.</summary>
    [Parameter] public string? ByeName { get; set; }
}
