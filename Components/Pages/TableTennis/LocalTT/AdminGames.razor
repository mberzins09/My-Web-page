@page "/tt-local/admin/tournament/{TournamentId:int}/games"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using MartinsWeb.Models
@using MartinsWeb.Services
@attribute [Authorize(Roles = "Admin")]
@inject TtLocalService Svc

<PageTitle>Games — @(_t?.TournamentName)</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/tt-local">🏓 Local tournaments</a></li>
        <li class="breadcrumb-item"><a href="/tt-local/tournament/@TournamentId">@(_t?.TournamentName ?? "Tournament")</a></li>
        <li class="breadcrumb-item active">Games</li>
    </ol>
</nav>

@if (_loading)
{
    <p class="text-muted">Loading...</p>
}
else if (_t == null)
{
    <div class="alert alert-warning">Tournament not found.</div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h4 class="mb-0">🎯 Games — @_t.TournamentName</h4>
        <a class="btn btn-outline-primary btn-sm" href="/tt-local/admin/tournament/@_t.Id/participants">👥 Participants</a>
    </div>
    <div class="text-muted small mb-3">
        @if (_t.HasGroups) { <span>Group games: @TtLocalLabels.SetsToWin(_t.SetsToWinGroup).</span> }
        @if (_t.HasPlayoff) { <span> Playoff games: @TtLocalLabels.SetsToWin(_t.SetsToWinPlayoff) · @TtLocalLabels.PlayoffType(_t.PlayoffType).</span> }
    </div>

    @if (_message != null)
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") alert-dismissible shadow m-0"
             style="position:fixed; bottom:1rem; left:50%; transform:translateX(-50%); z-index:1100; max-width:92vw">
            @_message
            <button type="button" class="btn-close" aria-label="Close" @onclick="() => _message = null"></button>
        </div>
    }

    @* ── actions ── *@
    <div class="d-flex flex-wrap gap-2 mb-3">
        @if (_t.HasGroups)
        {
            <button class="btn btn-primary btn-sm" @onclick="GenerateGroupGamesAsync">📋 Generate group schedule</button>
            <button class="btn btn-outline-primary btn-sm" @onclick="StartNewGroupGame">➕ Extra group game</button>
        }
        @if (_t.HasPlayoff)
        {
            <button class="btn btn-warning btn-sm" @onclick="GeneratePlayoffAsync">🏆 @(IsBlocks ? "Generate playoff (brackets / groups)" : "Generate playoff bracket")</button>
        }
    </div>

    @* ── new group game (popup) ── *@
    @if (_newGame)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" style="background:rgba(0,0,0,.55)">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">New group game</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="() => _newGame = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <select class="form-select" @bind="_newP1">
                                <option value="0">— player 1 —</option>
                                @foreach (var p in _participants) { <option value="@p.PlayerId">@p.Player?.FullName (@GroupLabel(p.GroupNumber))</option> }
                            </select>
                        </div>
                        <select class="form-select" @bind="_newP2">
                            <option value="0">— player 2 —</option>
                            @foreach (var p in _participants) { <option value="@p.PlayerId">@p.Player?.FullName (@GroupLabel(p.GroupNumber))</option> }
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" @onclick="() => _newGame = false">Cancel</button>
                        <button class="btn btn-primary" @onclick="CreateGroupGameAsync">Create</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── result entry (popup) ── *@
    @if (_editing != null)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" style="background:rgba(0,0,0,.55)">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title mb-0">Result</h5>
                            <div class="text-muted small">@GameTitle(_editing) · @TtLocalLabels.SetsToWin(EditingToWin)</div>
                        </div>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="() => _editing = null"></button>
                    </div>
                    <div class="modal-body">
                        <div class="fw-semibold mb-3 text-center">
                            @PName(_editing, _editing.Player1) <span class="text-muted">vs</span> @PName(_editing, _editing.Player2)
                        </div>

                        <div class="mb-1 small text-muted">Set points <span>(optional - leave empty to record only the sets)</span></div>
                        @for (int i = 0; i < _setInputs.Count; i++)
                        {
                            int idx = i;
                            <div class="d-flex align-items-center gap-2 mb-1" @key="idx">
                                <span style="width:56px">Set @(idx + 1)</span>
                                <input type="number" min="0" class="form-control form-control-sm" style="width:80px"
                                       @bind="_setInputs[idx].P1" @bind:event="oninput" />
                                <span>:</span>
                                <input type="number" min="0" class="form-control form-control-sm" style="width:80px"
                                       @bind="_setInputs[idx].P2" @bind:event="oninput" />
                            </div>
                        }

                        <div class="mt-3">
                            @if (AnySetPoints)
                            {
                                <div>Sets won (from set points): <strong>@DerivedP1 : @DerivedP2</strong></div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span>Sets won:</span>
                                    <input type="number" min="0" class="form-control form-control-sm" style="width:80px" @bind="_manualP1" />
                                    <span>:</span>
                                    <input type="number" min="0" class="form-control form-control-sm" style="width:80px" @bind="_manualP2" />
                                </div>
                            }
                        </div>

                        @if (_editError != null) { <div class="alert alert-danger mt-3 mb-0">@_editError</div> }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" @onclick="() => _editing = null">Cancel</button>
                        <button class="btn btn-primary" @onclick="SaveResultAsync">Save result</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── group games ── *@
    @if (_t.HasGroups)
    {
        <h5 class="mt-4">Group games</h5>
        @if (_groupGames.Count == 0)
        {
            <p class="text-muted">No group games yet. Add participants, assign groups, then generate the schedule.</p>
        }
        else
        {
            @foreach (var grp in _groupGames.GroupBy(g => g.GroupNumber ?? 0).OrderBy(g => g.Key))
            {
                <div class="fw-semibold mt-3">Group @TtLocalLabels.GroupName(grp.Key)</div>
                @GamesTable(grp.OrderBy(g => g.Round).ThenBy(g => g.Id).ToList(), true)
            }
            <div class="mt-2">
                @if (_confirm == "group")
                {
                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteStageAsync(TtLocalLabels.StageGroup)">Yes, delete all group games</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirm = null">No</button>
                }
                else
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick='() => _confirm = "group"'>🗑 Delete all group games</button>
                }
            </div>
        }
    }

    @* ── playoff games ── *@
    @if (_t.HasPlayoff)
    {
        <h5 class="mt-4">Playoff games</h5>
        @if (_playoffGames.Count == 0 && _blockGroupGames.Count == 0 && _blocks.Count == 0)
        {
            <p class="text-muted">The playoff has not been generated yet.</p>
        }
        else
        {
            @if (IsBlocks)
            {
                @foreach (var blk in _blocks)
                {
                    <h6 class="mt-4">
                        Places @blk.PlaceFrom–@blk.PlaceTo
                        <span class="badge bg-secondary ms-1">@BlockKindLabel(blk)</span>
                    </h6>
                    @if (blk.Kind == "bracket")
                    {
                        @foreach (var grp in PlayoffGroups(blk.Number))
                        {
                            <div class="fw-semibold mt-3">@grp.Title</div>
                            @GamesTable(grp.Games, false)
                        }
                        <div class="mt-3"><BracketView Games="BlockPlayoffGames(blk.Number)" Type="TtPlayoffType.AllPlaces" Seeds="_seeds" PlaceOffset="blk.PlaceFrom - 1" /></div>
                    }
                    else if (blk.Kind == "group")
                    {
                        var newGames = _blockGroupGames.Where(g => g.Block == blk.Number).OrderBy(g => g.Round).ThenBy(g => g.Id).ToList();
                        @if (newGames.Count == 0)
                        {
                            <p class="text-muted">All games of this group were already played in the group stage.</p>
                        }
                        else
                        {
                            @GamesTable(newGames, false)
                        }
                        <p class="text-muted small">Games these players already played in the group stage count here and are not played again.
                            Players: @string.Join(", ", blk.Players.Select(p => p.FullName))</p>
                    }
                    else
                    {
                        <p class="text-muted">@blk.Players[0].FullName takes place @blk.PlaceFrom without a game.</p>
                    }
                }
            }
            else
            {
                @foreach (var grp in PlayoffGroups(null))
                {
                    <div class="fw-semibold mt-3">@grp.Title</div>
                    @GamesTable(grp.Games, false)
                }
                <div class="mt-3"><BracketView Games="_playoffGames" Type="_t.PlayoffType" Seeds="_seeds" /></div>
            }

            <div class="mt-3">
                @if (_confirm == "playoff")
                {
                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteStageAsync(TtLocalLabels.StagePlayoff)">Yes, delete the playoff</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirm = null">No</button>
                }
                else
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick='() => _confirm = "playoff"'>🗑 Delete playoff</button>
                }
            </div>
        }
    }
}

@code {
    class SetInput { public int? P1 { get; set; } public int? P2 { get; set; } }

    [Parameter] public int TournamentId { get; set; }

    bool _loading = true;
    TournamentTT? _t;
    List<GameTT> _groupGames = new(), _playoffGames = new(), _blockGroupGames = new();
    List<TtBlockInfo> _blocks = new();
    List<TournamentPlayerTT> _participants = new();

    string? _message; bool _messageIsError;
    string? _confirm;

    // new group game
    bool _newGame; int _newP1, _newP2;

    // result editor
    GameTT? _editing;
    List<SetInput> _setInputs = new();
    int? _manualP1, _manualP2;
    string? _editError;

    int EditingToWin => _editing == null ? 0
        : _editing.Stage == TtLocalLabels.StagePlayoff ? _t!.SetsToWinPlayoff : _t!.SetsToWinGroup;

    bool AnySetPoints => _setInputs.Any(s => s.P1 != null || s.P2 != null);
    int DerivedP1 => _setInputs.Count(s => s.P1 != null && s.P2 != null && s.P1 > s.P2);
    int DerivedP2 => _setInputs.Count(s => s.P1 != null && s.P2 != null && s.P2 > s.P1);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _t = await Svc.GetTournamentAsync(TournamentId);
        if (_t != null)
        {
            _participants = await Svc.GetParticipantsAsync(TournamentId);
            await LoadGamesAsync();
        }
        _loading = false;
    }

    Dictionary<int, int> _seeds = new();

    /// <summary>Playoff players are shown as "Name Surname (seed)"; group games just by name.</summary>
    string PName(GameTT g, PlayerTT? p) =>
        g.Stage == TtLocalLabels.StagePlayoff ? TtLocalLabels.WithSeed(p, _seeds) : (p?.FullName ?? "TBD");

    async Task LoadGamesAsync()
    {
        _participants = await Svc.GetParticipantsAsync(TournamentId);
        _seeds = _participants.Where(x => x.PlayoffSeed != null).ToDictionary(x => x.PlayerId, x => x.PlayoffSeed!.Value);
        var all = await Svc.GetGamesAsync(TournamentId);
        _groupGames   = all.Where(g => g.Stage == TtLocalLabels.StageGroup).ToList();
        _playoffGames = all.Where(g => g.Stage == TtLocalLabels.StagePlayoff).ToList();
        _blockGroupGames = all.Where(g => g.Stage == TtLocalLabels.StageBlockGroup).ToList();
        _blocks = IsBlocks ? TtLocalService.DescribeBlocks(_participants, all) : new();
    }

    void Info(string text)  { _message = text; _messageIsError = false; }
    void Error(string text) { _message = text; _messageIsError = true; }
    void Report(string? error, string okText) { if (error != null) Error(error); else Info(okText); }

    static string GroupLabel(int? g) => g == null ? "no group" : "Group " + TtLocalLabels.GroupName(g.Value);

    bool IsBlocks => _t!.PlayoffType == TtPlayoffType.PlacementBlocks;

    static string BlockKindLabel(TtBlockInfo b) => b.Kind switch
    {
        "bracket" => "all-places bracket",
        "group"   => "additional group",
        _         => "1 player"
    };

    /// <summary>Places before the first place of this block (0 when there are no blocks).</summary>
    int BlockOffset(int? block) =>
        block == null ? 0 : (_blocks.FirstOrDefault(b => b.Number == block)?.PlaceFrom ?? 1) - 1;

    List<GameTT> BlockPlayoffGames(int? block) => _playoffGames.Where(g => g.Block == block).ToList();

    int PlayoffRounds(int? block)
    {
        var games = BlockPlayoffGames(block);
        return games.Count == 0 ? 0 : games.Max(x => x.Round ?? 1);
    }

    string GameTitle(GameTT g)
    {
        if (g.Stage == TtLocalLabels.StagePlayoff) return PlayoffTitle(g);
        if (g.Stage == TtLocalLabels.StageBlockGroup)
        {
            var b = _blocks.FirstOrDefault(x => x.Number == g.Block);
            return b == null ? "Additional group" : $"Places {b.PlaceFrom}–{b.PlaceTo} · group";
        }
        return $"Group {TtLocalLabels.GroupName(g.GroupNumber ?? 1)}";
    }

    /// <summary>Single elimination: "Semi-final". All places: "Round 2 · Places 1–8".</summary>
    string PlayoffTitle(GameTT g) => _t!.BracketType == TtPlayoffType.AllPlaces
        ? $"Round {g.Round} · {TtLocalLabels.PoolLabel(1 << PlayoffRounds(g.Block), g.Round ?? 1, g.Position ?? 0, BlockOffset(g.Block))}"
        : TtLocalLabels.PlayoffRoundName(g.Round ?? 1, PlayoffRounds(g.Block));

    record PlayoffGroup(string Title, List<GameTT> Games);

    /// <summary>Playoff games of one block grouped for display; bye games nobody can play are hidden.</summary>
    List<PlayoffGroup> PlayoffGroups(int? block) => BlockPlayoffGames(block)
        .Where(g => !(g.IsBye && g.Player1Id == null && g.Player2Id == null))
        .GroupBy(g => PlayoffTitle(g))
        .Select(grp => new PlayoffGroup(grp.Key, grp.OrderBy(g => g.Round).ThenBy(g => g.Position).ToList()))
        .OrderBy(grp => grp.Games[0].Round).ThenBy(grp => grp.Games[0].Position)
        .ToList();

    // ── actions ───────────────────────────────────────────────────────────
    async Task GenerateGroupGamesAsync()
    {
        var (error, created) = await Svc.GenerateGroupGamesAsync(TournamentId);
        Report(error, created == 0 ? "Nothing new to create - all games already exist." : $"Created {created} group game(s).");
        await LoadGamesAsync();
    }

    async Task GeneratePlayoffAsync()
    {
        var error = await Svc.GeneratePlayoffAsync(TournamentId);
        Report(error, "Playoff bracket generated.");
        await LoadGamesAsync();
    }

    void StartNewGroupGame() { _newGame = true; _newP1 = _newP2 = 0; _message = null; }

    async Task CreateGroupGameAsync()
    {
        var error = await Svc.CreateGroupGameAsync(TournamentId, _newP1, _newP2);
        Report(error, "Game created.");
        if (error == null) _newGame = false;
        await LoadGamesAsync();
    }

    async Task DeleteStageAsync(string stage)
    {
        var error = await Svc.DeleteStageGamesAsync(TournamentId, stage);
        Report(error, "Deleted.");
        _confirm = null;
        _editing = null;
        await LoadGamesAsync();
    }

    async Task DeleteGameAsync(GameTT g)
    {
        var error = await Svc.DeleteGameAsync(g.Id);
        Report(error, "Game deleted.");
        await LoadGamesAsync();
    }

    async Task ClearResultAsync(GameTT g)
    {
        var error = await Svc.ClearResultAsync(g.Id);
        Report(error, "Result cleared.");
        if (_editing?.Id == g.Id) _editing = null;
        await LoadGamesAsync();
    }

    void StartEdit(GameTT g)
    {
        _editing = g; _editError = null; _message = null; _newGame = false;
        int toWin = g.Stage == TtLocalLabels.StagePlayoff ? _t!.SetsToWinPlayoff : _t!.SetsToWinGroup;
        int maxSets = toWin * 2 - 1;

        _setInputs = new List<SetInput>();
        var existing = g.Sets.OrderBy(s => s.SetNumber).ToList();
        for (int i = 0; i < maxSets; i++)
        {
            _setInputs.Add(i < existing.Count
                ? new SetInput { P1 = existing[i].Player1Points, P2 = existing[i].Player2Points }
                : new SetInput());
        }
        _manualP1 = g.Player1Sets; _manualP2 = g.Player2Sets;
    }

    async Task SaveResultAsync()
    {
        if (_editing == null) return;
        var points = _setInputs.Select(s => (s.P1, s.P2)).ToList();
        _editError = await Svc.SaveResultAsync(_editing.Id, _manualP1, _manualP2, points);
        if (_editError != null) return;
        _editing = null;
        Info("Result saved.");
        await LoadGamesAsync();
    }

    // ── shared table of games ─────────────────────────────────────────────
    RenderFragment GamesTable(List<GameTT> games, bool canDelete) => @<div class="table-responsive">
        <table class="table table-sm align-middle" style="max-width:820px">
            <tbody>
                @foreach (var g in games)
                {
                    <tr @key="g.Id">
                        @if (g.Round != null && !(g.Stage == TtLocalLabels.StagePlayoff))
                        {
                            <td class="text-muted small" style="width:60px">R@(g.Round)</td>
                        }
                        @if (g.IsBye)
                        {
                            <td colspan="3" class="text-muted">
                                @PName(g, g.Player1 ?? g.Player2)
                                <span class="badge bg-light text-dark border">bye - advances automatically</span>
                            </td>
                            <td></td>
                        }
                        else
                        {
                            <td class="@(g.IsFinished && g.Player1Sets > g.Player2Sets ? "fw-bold" : "")">@PName(g, g.Player1)</td>
                            <td class="text-center text-nowrap">
                                @if (g.IsFinished)
                                {
                                    <span class="badge bg-dark">@g.Player1Sets : @g.Player2Sets</span>
                                    @if (g.Sets.Count > 0)
                                    {
                                        <div class="text-muted" style="font-size:.72rem">
                                            @string.Join(", ", g.Sets.OrderBy(s => s.SetNumber).Select(s => $"{s.Player1Points}:{s.Player2Points}"))
                                        </div>
                                    }
                                }
                                else { <span class="text-muted">–</span> }
                            </td>
                            <td class="@(g.IsFinished && g.Player2Sets > g.Player1Sets ? "fw-bold" : "")">@PName(g, g.Player2)</td>
                            <td class="text-end text-nowrap">
                                @if (g.Player1Id != null && g.Player2Id != null)
                                {
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(g)">@(g.IsFinished ? "✏️ Edit" : "➕ Result")</button>
                                }
                                @if (g.IsFinished)
                                {
                                    <button class="btn btn-outline-secondary btn-sm" title="Mark as not played" @onclick="() => ClearResultAsync(g)">↺</button>
                                }
                                @if (canDelete)
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteGameAsync(g)">🗑</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>;
}
